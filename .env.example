# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Discord Application Client ID (from Discord Developer Portal)
DISCORD_CLIENT_ID=your_client_id_here

# Bot Owner ID (your Discord user ID)
OWNER_ID=your_discord_user_id

# Discord Guild ID (optional - for development, commands update instantly)
# Remove or leave empty for global commands (takes up to 1 hour to update)
DISCORD_GUILD_ID=

# Voice channel auto-disconnect timeout in minutes (default: 5, 0 = never)
VOICE_TIMEOUT_MINUTES=5

# Redis Configuration (required for sharding, optional otherwise)
ENABLE_REDIS=true
# REDIS_URL is auto-configured in docker-compose

# Sharding (enable for large bots with 2500+ servers)
ENABLE_SHARDING=false
SHARD_COUNT=auto

# Optional: Google Cloud TTS API Key
GOOGLE_CLOUD_API_KEY=

# Debug mode
DEBUG=false

# Logging
# Log level: error | warn | info | debug (default: info in production, debug in dev)
LOG_LEVEL=
# Set NODE_ENV=production for structured JSON logs (for Alloy/Loki ingestion)
NODE_ENV=

# Grafana Alloy -> Loki (observability)
LOKI_URL=
LOKI_USER=
LOKI_TOKEN=

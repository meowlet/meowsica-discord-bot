{
  "name": "meowsica-discord-bot",
  "version": "1.0.0",
  "description": "Discord TTS bot with i18n, persistence, redis cache, and google cloud voices",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.16.0",
    "better-sqlite3": "^8.4.0",
    "discord.js": "^14.11.0",
    "dotenv": "^16.3.1",
    "ioredis": "^5.3.2",
    "sodium-native": "^4.0.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.4",
    "@types/node": "^20.4.2",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}

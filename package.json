{
  "name": "meowsica-discord-bot",
  "version": "0.1.1",
  "description": "A small Discord music bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.7.5",
    "discord.js": "^13.6.0",
    "dotenv": "^10.0.0",
    "sodium": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^16.11.12",
    "prettier": "^2.5.0",
    "ts-node": "^10.4.0",
    "typescript": "^4.5.2"
  }
}

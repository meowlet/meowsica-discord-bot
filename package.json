{
  "name": "meowsica-discord-bot",
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "deploy": "bun run src/deploy.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.17.0",
    "@snazzah/davey": "^0.1.0",
    "discord.js": "^14.14.1",
    "drizzle-orm": "^0.30.10",
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "sodium-native": "^4.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.20.17",
    "prettier": "^3.3.2",
    "typescript": "^5.4.5"
  },
  "patchedDependencies": {
    "@discordjs/ws@1.2.3": "patches/@discordjs%2Fws@1.2.3.patch"
  }
}

{
  "name": "meowsica-discord-bot",
  "version": "0.2.1",
  "description": "Discord voice bot with i18n, persistence, and redis cache",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.14.0",
    "better-sqlite3": "^8.2.0",
    "discord.js": "^14.8.0",
    "dotenv": "^16.0.3",
    "ioredis": "^5.3.1",
    "sodium-native": "^4.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.3",
    "@types/node": "^18.15.0",
    "prettier": "^2.8.4",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.2"
  }
}

{
  "name": "meowsica-discord-bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "deploy": "bun run src/deploy.ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.17.0",
    "better-sqlite3": "^9.0.0",
    "discord.js": "^14.12.1",
    "dotenv": "^16.3.1",
    "ioredis": "^5.3.2",
    "sodium-native": "^4.0.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.4",
    "@types/bun": "latest",
    "prettier": "^3.0.3",
    "typescript": "^5.1.6"
  },
  "patchedDependencies": {
    "@discordjs/ws@1.2.3": "patches/@discordjs%2Fws@1.2.3.patch"
  }
}

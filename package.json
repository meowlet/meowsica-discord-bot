{
  "name": "meowsica-discord-bot",
  "version": "0.1.0",
  "description": "A small Discord music bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "discord.js": "^13.0.0",
    "dotenv": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^14.17.0",
    "prettier": "^2.3.2",
    "ts-node": "^10.1.0",
    "typescript": "^4.3.5"
  }
}

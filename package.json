{
  "name": "meowsica-discord-bot",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "start:direct": "bun run src/bot.ts",
    "dev": "bun --watch src/index.ts",
    "deploy": "bun run src/deploy.ts",
    "test": "bun test",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.0",
    "@snazzah/davey": "^0.1.8",
    "@types/node": "^25.0.3",
    "discord.js": "^14.16.3",
    "drizzle-orm": "^0.45.2",
    "glob": "^13.0.0",
    "sodium-native": "^5.0.10",
    "strip-comments": "^2.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.7.4",
    "typescript": "^5.7.2"
  },
  "patchedDependencies": {
    "@discordjs/ws@1.2.3": "patches/@discordjs%2Fws@1.2.3.patch"
  }

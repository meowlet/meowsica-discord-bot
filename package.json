{
  "name": "meowsica-discord-bot",
  "version": "0.1.1",
  "description": "Discord voice bot with i18n",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.9.0",
    "discord.js": "^13.8.1",
    "dotenv": "^16.0.0",
    "sodium": "^3.0.2"
  },
  "devDependencies": {
    "@types/node": "^17.0.31",
    "prettier": "^2.6.2",
    "ts-node": "^10.7.0",
    "typescript": "^4.6.4"
  }
}

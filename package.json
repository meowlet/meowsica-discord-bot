{
  "name": "meowsica-discord-bot",
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "deploy": "bun run src/deploy.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "@snazzah/davey": "^0.1.5",
    "discord.js": "^14.15.3",
    "drizzle-orm": "^0.40.0",
    "dotenv": "^16.4.5",
    "glob": "^11.0.0",
    "ioredis": "^5.4.1",
    "sodium-native": "^4.3.0",
    "strip-comments": "^2.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.25.0",
    "prettier": "^3.4.0",
    "typescript": "^5.5.4"
  },
  "patchedDependencies": {
    "@discordjs/ws@1.2.3": "patches/@discordjs%2Fws@1.2.3.patch"
  }
}

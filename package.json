{
  "name": "meowsica-discord-bot",
  "version": "0.2.1",
  "description": "Discord voice bot with i18n and persistence",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.14.0",
    "better-sqlite3": "^8.0.1",
    "discord.js": "^14.7.1",
    "dotenv": "^16.0.3",
    "sodium-native": "^4.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.2",
    "@types/node": "^18.11.18",
    "prettier": "^2.8.2",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.4"
  }
}

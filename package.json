{
  "name": "meowsica-discord-bot",
  "version": "0.2.0",
  "description": "Discord voice bot with i18n",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\""
  },
  "dependencies": {
    "@discordjs/voice": "^0.11.0",
    "discord.js": "^14.0.0",
    "dotenv": "^16.0.1",
    "sodium-native": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "prettier": "^2.7.1",
    "ts-node": "^10.8.2",
    "typescript": "^4.7.4"
  }
}
